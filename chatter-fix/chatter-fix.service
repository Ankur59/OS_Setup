[Unit]
Description=Drop double-registered key presses on the Hydra 10 keyboard (wireless and wired)
After=systemd-udevd.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/chatter-fix --keys KEY_E --threshold-ms 50
Restart=on-failure
RestartSec=2
Nice=-5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=null
StandardError=null
LogLevelMax=warning

[Install]
WantedBy=multi-user.target
